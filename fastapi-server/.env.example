# ─── LazeeBrowse.ai environment template ───────────────────────────────
# Copy this file to `.env` and fill in your credentials:
#
#   cp fastapi-server/.env.example fastapi-server/.env
#
# API keys can alternatively (and by default) be entered directly in the
# LazeeBrowse.ai UI — they are sent per-session over WebSocket and stored
# locally in the SQLite settings DB. The variables below are mainly used
# by the Docker deployment and by older bundled backends.

# ── Model providers ─────────────────────────────────────────────────────
# Only enable the providers you actually use.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Default model tags (used as fallbacks)
OPENAI_MODEL=openai:gpt-5-nano
GEMINI_MODEL=gemini-3-flash-preview

# ── Vision model (LFM2.5-VL) ──────────────────────────────────────────
# Used by uitars_describe for screenshot-based page analysis.
# Model path: ~/Models/LFM2.5-VL-3B-MLX-8bit (~3.5 GB)
# Requires: pip install mlx-vlm Pillow
# No API key needed — runs fully local on Apple Silicon.
# LFM_MODEL=~/Models/LFM2.5-VL-3B-MLX-8bit

# ── Optional integrations ───────────────────────────────────────────────
# Email delivery (Mailtrap SMTP)
MAILTRAP_API_KEY=
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

# Gmail app password (2FA required)
GMAIL_EMAIL_ID=
GMAIL_APP_PASSWORD=

# LinkedIn automation
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=

# Google Cloud (Vertex / GenAI)
GCP_PROJECT_ID=
